{
  "name": "arencon-toolkit",
  "version": "0.0.0",
  "private": true,
  "description": "ARENCON Fire Protection Toolkit — test scaffolding only. The web app itself is static HTML/JS served by GitHub Pages and does NOT depend on this package.json.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run frt/tests/unit",
    "test:contracts": "vitest run frt/tests/contracts",
    "test:coverage": "vitest run --coverage frt/tests/unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@vitest/coverage-v8": "^2.1.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.4"
  }
}
